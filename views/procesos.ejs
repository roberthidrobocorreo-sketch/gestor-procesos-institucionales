<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Procesos Institucionales | Escuela "Las Américas"</title>
    <meta name="description" content="Gestión de procesos y trámites estudiantiles de la Escuela Las Américas">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/sidebar') %>

<main class="main-wrapper">

    <!-- ENCABEZADO -->
    <div class="section-header-box">
        <div>
            <h1 class="section-title">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Procesos
            </h1>
            <p class="section-subtitle">Registro y seguimiento de trámites estudiantiles institucionales</p>
        </div>
        <div class="header-actions">
            <button class="btn-primary" onclick="abrirModalNuevoProceso()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
                </svg>
                Nuevo Proceso
            </button>
        </div>
    </div>

    <!-- BARRA DE FILTROS -->
    <div class="toolbar-container">
        <div class="search-input-wrapper">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="searchProcessInput" class="search-field" placeholder="Buscar por estudiante o cédula...">
        </div>
        <select id="filterTipoProceso" class="filter-select">
            <option value="">Todos los tipos</option>
            <option value="Planilla de Inscripción">Planilla de Inscripción</option>
            <option value="Carta de Buena Conducta">Carta de Buena Conducta</option>
            <option value="Carta de Aceptación">Carta de Aceptación</option>
            <option value="Carta de Retiro">Carta de Retiro</option>
            <option value="Constancia de Promoción">Constancia de Promoción</option>
            <option value="Constancia de Estudio">Constancia de Estudio</option>
            <option value="Boletín Informativo">Boletín Informativo</option>
            <option value="Otro">Otro</option>
        </select>
        <select id="filterEstadoProceso" class="filter-select">
            <option value="">Todos los estados</option>
            <option value="Completado">Completado</option>
            <option value="En Trámite">En Trámite</option>
            <option value="Pendiente">Pendiente</option>
        </select>
        <span style="font-size: 0.85rem; color: #64748b; white-space: nowrap;">
            <strong><%= procesos.length %></strong> registros
        </span>
    </div>

    <!-- TABLA DE PROCESOS -->
    <div class="table-card-wrapper">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Estudiante</th>
                    <th>Grado / Sección</th>
                    <th>Tipo de Proceso</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Descripción</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (procesos && procesos.length > 0) { %>
                    <% procesos.forEach(function(proc) { %>
                    <tr class="process-table-row"
                        data-estudiante="<%= (proc.nombre + ' ' + proc.apellido).toLowerCase() %>"
                        data-cedula="<%= proc.estudiante_cedula.toLowerCase() %>"
                        data-tipo="<%= proc.tipo_proceso %>"
                        data-estado="<%= proc.estado %>">
                        <td style="color: #94a3b8; font-size: 0.85rem;">#<%= proc.id %></td>
                        <td>
                            <div class="student-meta-cell">
                                <% if (proc.foto) { %>
                                    <img src="<%= proc.foto %>" alt="<%= proc.nombre %>" class="student-avatar-img" style="width:34px;height:34px;object-fit:cover;border-radius:50%;border:2px solid var(--color-primario);">
                                <% } else { %>
                                    <div class="student-avatar-badge" style="width:32px;height:32px;font-size:0.75rem;">
                                        <%= (proc.nombre.charAt(0) + proc.apellido.charAt(0)).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div>
                                    <div class="student-main-name"><%= proc.nombre %> <%= proc.apellido %></div>
                                    <div class="student-sub-cedula">C.I: <%= proc.estudiante_cedula %></div>
                                </div>
                            </div>
                        </td>
                        <td><%= proc.ano %> "<%= proc.seccion %>"</td>
                        <td style="font-weight: 600; color: #334155;"><%= proc.tipo_proceso %></td>
                        <td style="font-size: 0.88rem; color: #64748b; min-width: 140px;"><%= proc.fecha %></td>
                        <td>
                            <span class="status-pill <%= proc.estado === 'Completado' ? 'completado' : proc.estado === 'En Trámite' ? 'tramite' : 'pendiente' %>">
                                <span class="status-indicator-dot" style="width:7px;height:7px;box-shadow:none; background: <%= proc.estado === 'Completado' ? '#15803d' : proc.estado === 'En Trámite' ? '#b45309' : '#0369a1' %>"></span>
                                <%= proc.estado %>
                            </span>
                        </td>
                        <td style="font-size: 0.85rem; color: #64748b; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <%= proc.descripcion || '—' %>
                        </td>
                        <td>
                            <div class="table-action-btns" style="justify-content: center;">
                                <!-- Imprimir -->
                                <a href="/imprimirProceso/<%= proc.id %>" target="_blank" class="action-icon-btn" title="Ver constancia">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                                    </svg>
                                </a>
                                <!-- Editar -->
                                <button class="action-icon-btn" title="Editar proceso"
                                    data-id="<%= proc.id %>"
                                    data-estudiante="<%= proc.nombre %> <%= proc.apellido %>"
                                    data-cedula="<%= proc.estudiante_cedula %>"
                                    data-tipo="<%= proc.tipo_proceso %>"
                                    data-fecha="<%= proc.fecha %>"
                                    data-estado="<%= proc.estado %>"
                                    data-descripcion="<%= (proc.descripcion || '').replace(/"/g, '&quot;') %>"
                                    data-datos_especificos="<%= (proc.datos_especificos || '').replace(/"/g, '&quot;') %>"
                                    onclick="abrirModalEditarProceso(this)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <!-- Eliminar -->
                                <button class="action-icon-btn delete" title="Eliminar proceso"
                                    onclick="eliminarProceso(<%= proc.id %>, '<%= proc.tipo_proceso %>')">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
                <tr id="noResultsProcessRow" style="display: none;">
                    <td colspan="8" style="text-align: center; padding: 3rem; color: #94a3b8;">Sin resultados para la búsqueda.</td>
                </tr>
                <% if (!procesos || procesos.length === 0) { %>
                <tr>
                    <td colspan="8" style="text-align: center; padding: 4rem; color: #94a3b8;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 1rem; opacity: 0.4; display: block;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <p style="font-size: 1.1rem; font-weight: 500;">No hay procesos registrados.</p>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>

</main>

<!-- MODAL: NUEVO PROCESO -->
<div class="modal-overlay" id="modalNuevoProceso">
    <div class="modal-dialog" style="max-width: 560px;">
        <div class="modal-header">
            <h3>Registrar Nuevo Proceso</h3>
            <button class="btn-close-modal" onclick="cerrarModal('modalNuevoProceso')">×</button>
        </div>
        <div class="modal-body">
            <form id="formNuevoProceso">
                <input type="hidden" id="nuevo_datos_especificos" name="datos_especificos" value="">
                <div class="form-field-group">
                    <label for="nuevo_proceso_estudiante">Estudiante *</label>
                    <select id="nuevo_proceso_estudiante" name="estudiante_cedula" required onchange="onEstudianteSeleccionado('nuevo')">
                        <option value="">Seleccionar estudiante...</option>
                        <% if (estudiantes && estudiantes.length > 0) { %>
                        <% estudiantes.forEach(function(est) { %>
                        <option value="<%= est.cedula %>"
                            data-nombre="<%= est.nombre %>"
                            data-apellido="<%= est.apellido %>"
                            data-cedula="<%= est.cedula %>"
                            data-ano="<%= est.ano %>"
                            data-seccion="<%= est.seccion %>"
                            data-representante="<%= est.representante || '' %>"
                            data-telefono="<%= est.telefono || '' %>"
                            data-correo="<%= est.correo || '' %>"
                            data-estado="<%= est.estado || 'Activo' %>"
                            data-foto="<%= est.foto || '' %>">
                            <%= est.nombre %> <%= est.apellido %> — <%= est.ano %> "<%= est.seccion %>" (C.I: <%= est.cedula %>)<%= est.estado === 'Inhabilitado' ? ' [Inhabilitado / Egresado]' : '' %>
                        </option>
                        <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="form-field-group">
                    <label for="nuevo_tipo_proceso">Tipo de Proceso *</label>
                    <select id="nuevo_tipo_proceso" name="tipo_proceso" required onchange="onTipoProcesoSeleccionado('nuevo')">
                        <option value="">Seleccionar...</option>
                        <option value="Planilla de Inscripción">Planilla de Inscripción</option>
                        <option value="Carta de Buena Conducta">Carta de Buena Conducta</option>
                        <option value="Carta de Aceptación">Carta de Aceptación</option>
                        <option value="Carta de Retiro">Carta de Retiro</option>
                        <option value="Constancia de Promoción">Constancia de Promoción (6to Grado)</option>
                        <option value="Constancia de Estudio">Constancia de Estudio</option>
                        <option value="Boletín Informativo" disabled>Boletín Informativo (no disponible)</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

                <!-- CAJA DE REQUISITOS DINÁMICOS -->
                <div id="nuevo_requisitos_box" class="requisitos-card-box" style="display: none;">
                    <div class="requisitos-status-indicator">
                        <div>
                            <span id="nuevo_req_badge" class="badge-status-req pendiente">⚠️ Requisitos pendientes</span>
                            <p id="nuevo_req_summary" style="font-size: 0.82rem; color: #475569; margin-top: 4px;">Este trámite cuenta con campos específicos requeridos.</p>
                        </div>
                        <button type="button" class="btn-open-requisitos" onclick="abrirVentanaRequisitos('nuevo')">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Rellenar Requisitos
                        </button>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-field-group">
                        <label for="nuevo_fecha_proceso">Fecha de Emisión *</label>
                        <input type="date" id="nuevo_fecha_proceso" name="fecha" required>
                    </div>
                    <div class="form-field-group">
                        <label for="nuevo_estado_proceso">Estado</label>
                        <select id="nuevo_estado_proceso" name="estado">
                            <option value="Completado">Completado</option>
                            <option value="En Trámite">En Trámite</option>
                            <option value="Pendiente">Pendiente</option>
                        </select>
                    </div>
                </div>
                <div class="form-field-group">
                    <label for="nuevo_descripcion_proceso">Descripción / Resumen</label>
                    <textarea id="nuevo_descripcion_proceso" name="descripcion" rows="3" placeholder="Descripción del trámite..." style="resize: vertical;"></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="cerrarModal('modalNuevoProceso')">Cancelar</button>
            <button class="btn-primary" onclick="document.getElementById('formNuevoProceso').dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))">
                Registrar Proceso
            </button>
        </div>
    </div>
</div>

<!-- MODAL: EDITAR PROCESO -->
<div class="modal-overlay" id="modalEditarProceso">
    <div class="modal-dialog" style="max-width: 560px;">
        <div class="modal-header">
            <h3>Modificar Proceso</h3>
            <button class="btn-close-modal" onclick="cerrarModal('modalEditarProceso')">×</button>
        </div>
        <div class="modal-body">
            <form id="formEditarProceso">
                <input type="hidden" id="edit_proceso_id">
                <input type="hidden" id="edit_proceso_cedula">
                <input type="hidden" id="edit_datos_especificos" name="datos_especificos" value="">
                <div class="form-field-group">
                    <label>Estudiante</label>
                    <div style="padding: 0.75rem 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-weight: 600; color: #334155;" id="edit_proceso_estudiante_info"></div>
                </div>
                <div class="form-field-group">
                    <label for="edit_tipo_proceso">Tipo de Proceso</label>
                    <select id="edit_tipo_proceso" name="tipo_proceso" onchange="onTipoProcesoSeleccionado('edit')">
                        <option value="Planilla de Inscripción">Planilla de Inscripción</option>
                        <option value="Carta de Buena Conducta">Carta de Buena Conducta</option>
                        <option value="Carta de Aceptación">Carta de Aceptación</option>
                        <option value="Carta de Retiro">Carta de Retiro</option>
                        <option value="Constancia de Promoción">Constancia de Promoción (6to Grado)</option>
                        <option value="Constancia de Estudio">Constancia de Estudio</option>
                        <option value="Boletín Informativo" disabled>Boletín Informativo (no disponible)</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

                <!-- CAJA DE REQUISITOS DINÁMICOS -->
                <div id="edit_requisitos_box" class="requisitos-card-box" style="display: none;">
                    <div class="requisitos-status-indicator">
                        <div>
                            <span id="edit_req_badge" class="badge-status-req pendiente">⚠️ Requisitos pendientes</span>
                            <p id="edit_req_summary" style="font-size: 0.82rem; color: #475569; margin-top: 4px;">Este trámite cuenta con campos específicos requeridos.</p>
                        </div>
                        <button type="button" class="btn-open-requisitos" onclick="abrirVentanaRequisitos('edit')">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Modificar Requisitos
                        </button>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-field-group">
                        <label for="edit_fecha_proceso">Fecha de Emisión *</label>
                        <input type="date" id="edit_fecha_proceso" name="fecha" required>
                    </div>
                    <div class="form-field-group">
                        <label for="edit_estado_proceso">Estado</label>
                        <select id="edit_estado_proceso" name="estado">
                            <option value="Completado">Completado</option>
                            <option value="En Trámite">En Trámite</option>
                            <option value="Pendiente">Pendiente</option>
                        </select>
                    </div>
                </div>
                <div class="form-field-group">
                    <label for="edit_descripcion_proceso">Descripción / Resumen</label>
                    <textarea id="edit_descripcion_proceso" name="descripcion" rows="3" style="resize: vertical;"></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-secondary" onclick="cerrarModal('modalEditarProceso')">Cancelar</button>
            <button class="btn-primary" onclick="document.getElementById('formEditarProceso').dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))">
                Guardar Cambios
            </button>
        </div>
    </div>
</div>

<!-- MODAL: VENTANA DE REQUISITOS ESPECÍFICOS (SE PONE SOBRE LA VENTANA DE PROCESO) -->
<div class="modal-overlay" id="modalRequisitosProceso" style="z-index: 2500; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px);">
    <div class="modal-dialog" style="max-width: 780px; width: 95%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);">
        <div class="modal-header" style="border-bottom: 2px solid #e2e8f0; background: #f8fafc;">
            <div>
                <h3 id="modalRequisitosTitulo" style="color: var(--color-primario-oscuro); font-size: 1.25rem;">Requisitos del Proceso</h3>
                <p id="modalRequisitosSubtitulo" style="font-size: 0.85rem; color: #64748b; margin-top: 3px;">Seleccione el estudiante para autocompletar sus datos y complete los campos específicos.</p>
            </div>
            <button class="btn-close-modal" onclick="cerrarVentanaRequisitos()">×</button>
        </div>
        <div class="modal-body" style="overflow-y: auto; padding: 1.5rem; flex: 1;">
            
            <!-- SELECTOR DE ESTUDIANTE DE LA BASE DE DATOS DENTRO DE LA VENTANA DE REQUISITOS -->
            <div class="form-field-group" id="req_student_selector_wrapper" style="background: #f0fdf4; border: 1.5px solid #86efac; padding: 14px 16px; border-radius: 12px; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label for="req_estudiante_select" style="font-weight: 700; color: #166534; font-size: 0.95rem; margin-bottom: 0;">
                        🎓 Seleccionar Estudiante de la Base de Datos *
                    </label>
                    <span id="req_autocompletado_badge" style="font-size: 0.78rem; background: #dcfce7; color: #15803d; padding: 3px 10px; border-radius: 12px; font-weight: 700; border: 1px solid #86efac;">
                        ✓ Datos autocompletados
                    </span>
                </div>
                <select id="req_estudiante_select" onchange="alCambiarEstudianteEnRequisitos(this.value)" style="width: 100%; font-weight: 600; padding: 0.65rem 1rem; border: 1.5px solid #16a34a; border-radius: 8px; background: #ffffff; color: #1e293b;">
                    <option value="">-- Seleccionar estudiante de la base de datos... --</option>
                    <% if (estudiantes && estudiantes.length > 0) { %>
                    <% estudiantes.forEach(function(est) { %>
                    <option value="<%= est.cedula %>"
                        data-nombre="<%= est.nombre %>"
                        data-apellido="<%= est.apellido %>"
                        data-cedula="<%= est.cedula %>"
                        data-ano="<%= est.ano %>"
                        data-seccion="<%= est.seccion %>"
                        data-representante="<%= est.representante || '' %>"
                        data-telefono="<%= est.telefono || '' %>"
                        data-correo="<%= est.correo || '' %>"
                        data-estado="<%= est.estado || 'Activo' %>"
                        data-foto="<%= est.foto || '' %>">
                        <%= est.nombre %> <%= est.apellido %> — <%= est.ano %> "<%= est.seccion %>" (C.I: <%= est.cedula %>)<%= est.estado === 'Inhabilitado' ? ' [Inhabilitado / Egresado]' : '' %>
                    </option>
                    <% }); %>
                    <% } %>
                </select>
                <p style="font-size: 0.8rem; color: #15803d; margin-top: 5px;">
                    Al seleccionar el alumno, sus datos básicos se autocompletan inmediatamente para este trámite.
                </p>
            </div>

            <form id="formRequisitosProceso" onsubmit="event.preventDefault(); guardarRequisitosYRegresar();">
                <div id="contenedorRequisitosDinamicos">
                    <!-- Los campos dinámicos se inyectan mediante JavaScript según el tipo de proceso -->
                </div>
            </form>
        </div>
        <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; border-top: 2px solid #f1f5f9; background: #f8fafc;">
            <button type="button" class="btn-secondary" onclick="cerrarVentanaRequisitos()">
                Volver a la Solicitud
            </button>
            <button type="button" class="btn-primary" onclick="guardarRequisitosYRegresar()" style="display: inline-flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Guardar Requisitos y Volver
            </button>
        </div>
    </div>
</div>

<div id="toastNotification" class="toast-notification"></div>

