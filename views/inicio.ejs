<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio — Gestor Institucional | Escuela "Las Américas"</title>
    <meta name="description" content="Panel principal del Gestor de Procesos de la Escuela Las Américas">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/sidebar') %>

<main class="main-wrapper">

    <!-- SALUDO + RELOJ DIGITAL (FIEL A LA IMAGEN) -->
    <div class="clock-container">
        <p class="hero-greeting">
            Bienvenido/a de nuevo, <span class="user-name-tag"><%= nombreUsuario %></span>
        </p>
        <div class="digital-time">
            <span id="liveClockDigits">00:00</span>
            <span id="liveClockAmpm" class="am-pm">a.m.</span>
        </div>
        <p class="digital-date" id="liveClockDate">Cargando fecha...</p>
    </div>

    <!-- TARJETAS PRINCIPALES: ÚLTIMOS REGISTRADOS + AVISOS -->
    <div class="dashboard-cards-container">

        <!-- TARJETA: ESTUDIANTES RECIENTES -->
        <div class="rounded-dashboard-card">
            <div class="card-header-title">
                <span>Estudiantes Recientes</span>
                <a href="/baseDatos" class="btn-action-small">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                    Ver todos
                </a>
            </div>

            <div class="process-items-list">
               

                
            </div>
        </div>

        <!-- TARJETA AVISOS (BANDEJA VACÍA = carita feliz, fiel a la imagen) -->
        <div class="rounded-dashboard-card">
            <div class="card-header-title">
                <span>Avisos</span>
                <% if (avisos && avisos.length > 0) { %>
                <button onclick="vaciarAvisos()" class="btn-action-small" style="color: #b91c1c;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Vaciar
                </button>
                <% } %>
            </div>

            <% if (!avisos || avisos.length === 0) { %>
            <!-- BANDEJA VACÍA con carita (idéntico a imagen) -->
            <div class="avisos-card-inner">
                <svg class="smiley-face-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10"/>
                    <path stroke-linecap="round" d="M8.5 15.5s1 1.5 3.5 1.5 3.5-1.5 3.5-1.5"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.5h.01M15 9.5h.01"/>
                </svg>
                <p class="empty-tray-text">Bandeja Vacía</p>
            </div>
            <% } else { %>
            <div class="avisos-list">
                <% avisos.forEach(function(av) { %>
                <div class="aviso-item-card">
                    <div class="aviso-header">
                        <span class="aviso-title"><%= av.titulo %></span>
                        <span class="aviso-date"><%= av.fecha %></span>
                    </div>
                    <p class="aviso-body"><%= av.contenido %></p>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

    </div><!-- /dashboard-cards-container -->

    <!-- CHIPS DE ESTADÍSTICAS -->
    <div class="quick-stats-bar">
        <div class="stat-chip">
            <div class="stat-chip-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <div class="stat-chip-info">
                <h4>Total Estudiantes</h4>
                
            </div>
        </div>
        <div class="stat-chip">
            <div class="stat-chip-icon" style="background: rgba(34,197,94,0.1); color: #15803d;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <div class="stat-chip-info">
                <h4>Activos</h4>
                
            </div>
        </div>
        <div class="stat-chip">
            <div class="stat-chip-icon" style="background: rgba(239,68,68,0.1); color: #b91c1c;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
            <div class="stat-chip-info">
                <h4>Retirados</h4>
                
            </div>
        </div>
        <div class="stat-chip">
            <div class="stat-chip-icon" style="background: rgba(245,158,11,0.1); color: #b45309;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
            </div>
            <div class="stat-chip-info">
                <h4>Egresados</h4>
                
            </div>
        </div>
    </div>

</main>

<div id="toastNotification" class="toast-notification"></div>

<script src="/scripts/ui.js"></script>
<script src="/scripts/dashboard.js"></script>
</body>
</html>
