# Puerto del servidor (por defecto 3001)
PORT=3001

# Clave secreta para firmar las sesiones (JWT).
# Usa una clave larga y aleatoria, y no la compartas ni la publiques.
JWT_SECRET=coloca_aqui_una_clave_larga_y_aleatoria

# Nota: el sistema usa SQLite. La base de datos es el archivo local
# database.sqlite, que se crea sola al iniciar; no necesita configuración aquí.
